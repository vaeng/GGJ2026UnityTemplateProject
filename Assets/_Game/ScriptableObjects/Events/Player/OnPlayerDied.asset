--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b58ed87f6d683ae4380c703929b4aac3, type: 3}
  m_Name: OnPlayerDied
  m_EditorClassIdentifier: Assembly-CSharp::GameEvent
  enableDebugLogs: 0
  description: 'Raised when the player dies (health reaches zero or instant death
    trigger).


    Common Listeners:

    - UIManager: Show death screen or game
    over panel

    - AudioManager: Play death sound effect

    - CameraController:
    Trigger screen shake or death camera zoom

    - ScoreManager: Reset combo multiplier,
    calculate death penalty

    - ParticleManager: Spawn death particle effects

    -
    GameManager: Check remaining lives, decide if game over

    - AchievementManager:
    Track death count for statistics

    - RespawnManager: Start respawn timer/countdown


    Use
    Case:

    This fires on EACH death. If player has multiple lives, this will
    fire

    multiple times per game. Use OnGameOver for final death that ends the
    game.'
