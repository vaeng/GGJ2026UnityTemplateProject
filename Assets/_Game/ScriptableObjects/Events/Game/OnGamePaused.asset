MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b58ed87f6d683ae4380c703929b4aac3, type: 3}
  m_Name: OnGamePaused
  m_EditorClassIdentifier: Assembly-CSharp::GameEvent
  enableDebugLogs: 0
  description: 'Raised when the game is paused (player presses pause button).


    Common
    Listeners:

    - UIManager: Show pause menu

    - AudioManager: Transition
    to "paused" audio snapshot (muffled music)

    - TimeManager: Set Time.timeScale
    = 0

    - PlayerController: Disable input

    - EnemyAI: Disable AI updates

    -
    ParticleManager: Pause all particle systems


    Use Case:

    Raise when player
    presses ESC or pause button. Should be paired with

    OnGameResumed event (create
    if needed). Use audio mixer snapshots

    for professional pause audio effect.'
